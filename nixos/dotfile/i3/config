exec_always --no-startup-id sudo xkeysnail $HOME/.config/xkeysnail/config.py
exec_always --no-startup-id sudo pkill espanso;espanso service start --unmanaged
exec_always --no-startup-id autorandr --change
exec_always --no-startup-id sudo pkill touchegg;touchegg

